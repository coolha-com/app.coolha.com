# Coolha 环境变量模板
#
# 用法：
#   cp .env.local.example .env.local
#   然后逐项填入真实值。**不要加引号**（scripts/apply-migration.mjs 用朴素解析器）。
#
# `.env*` 全部被 .gitignore 忽略，本文件是唯一的公开模板，**不得填入真实密钥后提交**。
# Vercel 云端配置见 docs/LOCAL_DEV.md；合规红线见 docs/ROUTE_A_BUSINESS_MODEL.md。

# ── 基础 ───────────────────────────────────────────────
NEXT_PUBLIC_APP_VERSION=0.1.2-alpha

# ── 钱包连接（Reown AppKit + wagmi）────────────────────
# NEXT_PUBLIC_REOWN_ID 与 REOWN_ID 指向同一个 AppKit project id
REOWN_ID=
NEXT_PUBLIC_REOWN_ID=
NEXT_PUBLIC_SIWE_ONECLICK=1
# 链上收款地址（订阅 USDC / USDT 的收款钱包，必须与 Vercel 云端一致）
SUBSCRIPTION_TREASURY_ADDRESS=

# ── AI Gateway（Vercel）────────────────────────────────
# 在 Vercel Dashboard → AI Gateway → API Keys 创建。创建后无法取回，丢失只能新建。
# key 默认归属创建者个人；团队成员离开会自动停用其创建的 key。
# 免费对话额度走这条链路，超额按 Vercel 侧计费。**部署前必须确认可用（当前生产 key已 401 失效）。**
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# 1 = 向下游声明不接受提示训练（合规要求，保持 1）
AI_GATEWAY_DISALLOW_TRAINING=1
# 1 = 开启零数据保留的赞助模型；0 = 全站关闭免费模型（熔断开关）
FREE_MODELS_ENABLED=1
# 手动强制刷新模型目录的令牌（/api/v1/models?refresh=1）
CATALOG_REFRESH_TOKEN=

# ── 数据库（Neon Postgres via Vercel 集成）─────────────
# pooled：应用查询走这条（src/lib/neon/postgres.ts）
DATABASE_URL=
# unpooled：迁移与 DDL 必须用它（PgBouncer 事务模式不支持会话级操作）
DATABASE_URL_UNPOOLED=

# ── Neon Managed Auth（邮箱登录，管理向）───────────────
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_MODEL=

# ── Alchemy（Webhook 主路径 + 扫链兜底）────────────────
ALCHEMY_ID=
ALCHEMY_KEY=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# ── 定时任务 ───────────────────────────────────────────
CRON_SECRET=

# ── 地域屏蔽（proxy.ts 硬屏蔽）────────────────────────
GEO_BLOCKED_COUNTRIES=CN
GEO_HARD_BLOCKED_COUNTRIES=CN
GEO_SOFT_GATED_COUNTRIES=