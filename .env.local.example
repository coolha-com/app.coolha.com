# ══════════════════════════════════════════════════════════════════
# .env.local.example — 变量模板（照着填）
#   数据库：dev 分支  ·  收款：Waffo test 沙箱
#   用途：新环境从这里拷。密钥一律留空，不要提交真值。
# ══════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────
# 本地专用（不同步到 Vercel）
# ────────────────────────────────────────────────────────────

# `next start` 也是 NODE_ENV=production；没有它，/eve/v1/* 不会 rewrite 到本机 Runtime。
COOLHA_EVE_LOCAL=1

# ────────────────────────────────────────────────────────────
# 统一推理网关（OpenAI 兼容 · OpenRouter）
# ────────────────────────────────────────────────────────────

# 换厂商只改这几行，代码不动。白名单外的模型会被服务端拒掉。
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_GATEWAY_NAME=OpenRouter
INFERENCE_MODELS=
INFERENCE_DEFAULT_MODEL=
INFERENCE_CONTEXT_WINDOW=

# ────────────────────────────────────────────────────────────
# Agent 运行时（eve Runtime）
# ────────────────────────────────────────────────────────────

# 云端必须显式配：缺任一项，/api/eve/v1/* 返回 503（fail-closed）。
# 本地由 npm run dev:all 自动注入这两个值。
EVE_RUNTIME_ORIGIN=
EVE_INTERNAL_SECRET=

# ────────────────────────────────────────────────────────────
# 收款（Waffo · Merchant of Record）
# ────────────────────────────────────────────────────────────

# 一次购买 = 一份服务授权：19 U/次 · 30 天有效 · token 价值上限 10 USD。
# 商户 / 店铺 / 商品：DASHBOARD → API 与开发 · 产品
WAFFO_MERCHANT_ID=
# RSA 私钥：只在本机/服务端读取，绝不能进客户端
WAFFO_PRIVATE_KEY=
WAFFO_STORE_ID=
# test = 沙箱（不产生真实扣款）；prod = 真实收款
WAFFO_ENVIRONMENT=test
WAFFO_PRODUCT_ID=
WAFFO_CURRENCY=USD
# Webhook 验签公钥：必须单行（多行会被 .env 解析器截断，验签 100% 失败）
# DASHBOARD → 设置 → Webhooks → RSA Public Key
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=

# ────────────────────────────────────────────────────────────
# 数据库（Neon Postgres）
# ────────────────────────────────────────────────────────────

# 直连迁移用 *_UNPOOLED（PgBouncer 事务模式下会话级操作不可靠）
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ────────────────────────────────────────────────────────────
# 认证（Neon Managed Auth）
# ────────────────────────────────────────────────────────────

# 与数据库同分支：换库必须同步换这个地址
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# ────────────────────────────────────────────────────────────
# 第三方与平台开关
# ────────────────────────────────────────────────────────────

# Alchemy（只读链上数据）
ALCHEMY_ID=
ALCHEMY_KEY=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Reown（AppKit / wagmi）
REOWN_ID=
NEXT_PUBLIC_REOWN_ID=

# 钱包一键签名登录：连钱包 → 自动弹签名 → 签完即登录
NEXT_PUBLIC_SIWE_ONECLICK=1

# 定时任务鉴权
CRON_SECRET=

# 订阅收款地址
SUBSCRIPTION_TREASURY_ADDRESS=

# 免费模型（赞助额度）开关
FREE_MODELS_ENABLED=1
