# Coolha 环境变量模板
#
# 用法：
#   cp .env.local.example .env.local
#   然后逐项填入真实值。**不要加引号**（scripts/apply-migration.mjs 用朴素解析器）。
#
# `.env*` 全部被 .gitignore 忽略，本文件是唯一的公开模板，**不得填入真实密钥后提交**。
# Vercel 云端配置见 docs/LOCAL_DEV.md；合规红线见 docs/ROUTE_A_BUSINESS_MODEL.md。

# ── 基础 ───────────────────────────────────────────────
NEXT_PUBLIC_APP_VERSION=0.1.2-alpha

# ── 钱包连接（Reown AppKit + wagmi）────────────────────
# NEXT_PUBLIC_REOWN_ID 与 REOWN_ID 指向同一个 AppKit project id
REOWN_ID=
NEXT_PUBLIC_REOWN_ID=
NEXT_PUBLIC_SIWE_ONECLICK=1
# 链上收款地址（订阅 USDC / USDT 的收款钱包，必须与 Vercel 云端一致）
SUBSCRIPTION_TREASURY_ADDRESS=

# ── 统一推理网关（OpenAI 兼容，唯一真相源 src/lib/inference/config.ts）──
# ⚠️ Vercel AI Gateway 团队于 2026-11-11 被永久停用（疑似滥用，无申诉通道），
#    全站已移除 AI_GATEWAY_* 依赖。请勿再配置这些旧变量。
# eve Runtime、/api/compute/playground、narrate 全部只连下面这一个网关。
# 换模型厂商 = 只改这里的环境变量，不用改代码。
#
# 任选一个 OpenAI 兼容端点即可，例如：
#   厂商直连   https://api.openai.com/v1 / https://api.deepseek.com/v1
#   聚合网关   https://openrouter.ai/api/v1 / https://api.groq.com/openai/v1
#   自建代理   http://127.0.0.1:4000/v1（LiteLLM 等）
# ⚠️ eve 是独立进程，不读 .env*.local；用 `npm run dev:all` 会自动把这些注入两个进程。
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
# 网关展示名，仅用于 UI / 日志标注
INFERENCE_GATEWAY_NAME=推理网关
# 允许使用的模型 ID，逗号分隔（服务端白名单，前端只能从里面选）
INFERENCE_MODELS=
# 默认模型，必须是 INFERENCE_MODELS 里的一个
INFERENCE_DEFAULT_MODEL=
# 上下文窗口（tokens）。自定义网关没有目录元数据，eve 需要它判断是否压缩
INFERENCE_CONTEXT_WINDOW=128000

# 1 = 开启平台模型通道；0 = 全站熔断
FREE_MODELS_ENABLED=1
# 手动强制刷新模型目录的令牌（/api/v1/models?refresh=1）
CATALOG_REFRESH_TOKEN=

# ── 数据库（Neon Postgres via Vercel 集成）─────────────
# 分支约定（2026-11-11 起）：
#   本地开发 → dev 分支（写进 .env.development.local，覆盖 .env.local）
#   生产     → main 分支（.env.local / .env.production.local）
#   `neon branches list --project-id <id>` 查分支；`neon neon-auth status --branch <name>` 查对应 Auth 端点。
#   **Neon Auth 是分支级的**，换 DATABASE_URL 必须同时换 NEON_AUTH_BASE_URL，否则身份写 main、业务写 dev。
# pooled：应用查询走这条（src/lib/neon/postgres.ts）
DATABASE_URL=
# unpooled：迁移与 DDL 必须用它（PgBouncer 事务模式不支持会话级操作）
DATABASE_URL_UNPOOLED=

# ── Neon Managed Auth（Web2 主登录：邮箱验证码 / 密码 / Google）────
# 必须与 DATABASE_URL 指向同一个分支
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_MODEL=

# ── Alchemy（Webhook 主路径 + 扫链兜底）────────────────
ALCHEMY_ID=
ALCHEMY_KEY=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# ── 定时任务 ───────────────────────────────────────────
CRON_SECRET=

# ── 地域屏蔽（proxy.ts 硬屏蔽）────────────────────────
GEO_BLOCKED_COUNTRIES=CN
GEO_HARD_BLOCKED_COUNTRIES=CN
GEO_SOFT_GATED_COUNTRIES=

# ── 本地 eve Runtime（仅本机，禁止同步到 Vercel）────────────────
# `next start` 也是 NODE_ENV=production。没有这个开关，本地构建不会 rewrite
# /eve/v1/*，代理也不会使用 127.0.0.1:4274 默认地址，表现为
# AGENT_RUNTIME_UNREACHABLE / AGENT_RUNTIME_NOT_CONFIGURED。
# 本机开发时手动取消注释；云端保持未设置，生产必须显式配置
# EVE_RUNTIME_ORIGIN + EVE_INTERNAL_SECRET（否则 fail-closed）。
# COOLHA_EVE_LOCAL=1
# EVE_RUNTIME_ORIGIN=http://127.0.0.1:4274
# EVE_INTERNAL_SECRET=
